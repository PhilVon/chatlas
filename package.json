{
  "name": "chatlas",
  "version": "1.0.0",
  "description": "Multi-platform streamer chat viewer — organized lanes, burst control, pinning, and hotkeys",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "tmi.js": "^1.8.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.0",
    "electron-builder": "^26.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.chatlas.app",
    "productName": "ChAtlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
